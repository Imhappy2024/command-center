# Railway injects PORT automatically — only set this for local runs.
PORT=3000

# ---------------------------------------------------------------------------
# Sources. Each is independent: leave a block blank and that panel reports
# "not configured" instead of inventing a number.
# ---------------------------------------------------------------------------

# ClickUp — Settings -> Apps -> API Token. Starts with pk_
CLICKUP_TOKEN=
# Optional. Defaults to your first team, and to your own user id.
CLICKUP_TEAM_ID=
CLICKUP_USER_ID=

# n8n — Settings -> n8n API -> Create an API key.
# Base URL is the instance root, no trailing /api/v1
N8N_BASE_URL=
N8N_API_KEY=

# Gmail — run `npm run auth:google` locally to mint the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Minutes between refreshes. 0 disables the timer (boot refresh still runs).
REFRESH_INTERVAL_MINUTES=15

# Name in the greeting. Falls back to the ClickUp username.
OWNER_NAME=

# Absolute path override for the generated payload.
# DATA_FILE=/app/data/dashboard.json
