# Copy to .env for local runs. Never commit the real thing.
# The server refuses to start if any of the four required variables is missing,
# and tells you which one.

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# open | remember | password. Defaults to remember when unset.
#
#   open      No gate. No /login, no redirect, no cookie check. APP_PASSWORD is
#             not required. The rail shows a "No login · public URL" marker so an
#             unprotected deployment never looks like a gated one. Anyone who
#             reaches the domain can read every connected mailbox.
#   remember  One sign-in per browser. 365-day cookie whose expiry slides forward
#             on every request, so a browser in regular use never lapses.
#   password  14-day cookie, no sliding.
AUTH_MODE=remember

# Required unless AUTH_MODE=open.
APP_PASSWORD=

# Signs session and OAuth state cookies. 32+ characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts refresh tokens and IMAP app passwords at rest. 32+ characters.
# Changing it makes every stored credential undecryptable — you reconnect.
ENCRYPTION_KEY=

# command-center's OWN tables: accounts (the encrypted mail tokens),
# webhook_events, sync_state, social_*. db/schema.sql creates them here on boot.
# Railway's Postgres plugin injects this. Leave it pointing there — repointing it
# at Supabase would orphan every connected mailbox.
DATABASE_URL=

# The portal database, where GHL data lives. command-center READS it, LISTENs on
# it for live updates, and writes to it only through the webhook processor and
# the send path. Take the string from Supabase -> Connect -> Session pooler:
#
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# The region is not guessable; copy the exact host. URL-encode the password:
# '!' becomes %21, '#' becomes %23.
#
# SESSION pooler on 5432, not the transaction pooler on 6543. LISTEN/NOTIFY —
# which is how a new sub-account reaches the sidebar without a reload — works in
# session mode and silently never fires in transaction mode. Boot and
# /api/ghl/diag both warn if 6543 is used.
#
# Unset, the GHL reads fall back to DATABASE_URL (single-database layout).
SUPABASE_DB_URL=

# NOT read by this app: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE,
# DATA_SOURCE. Those are the Supabase HTTP API credentials. command-center speaks
# SQL over the pooler, so it needs the connection string above and nothing else.
# Harmless if present.

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Public origin, no trailing slash. OAuth redirect URIs are built from this, and
# Railway's proxy reports http in req.protocol, so it cannot be inferred from
# request headers. Required — but on Railway it is derived automatically from the
# injected RAILWAY_PUBLIC_DOMAIN, so you only need to set it locally or to
# override a custom domain.
PUBLIC_URL=

# Railway injects its own. Only set this for local runs.
PORT=3000

# ---------------------------------------------------------------------------
# Google — Gmail and Google Calendar, one grant for both
# Cloud console -> Clients -> Create client -> Web application.
# Redirect URIs, both of them, byte for byte:
#   http://localhost:3000/oauth/callback/google
#   https://<your-railway-domain>/oauth/callback/google
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Microsoft — Graph mail and calendar, one grant for both
# Entra ID -> App registrations. Supported account types must be
# "any organizational directory and personal Microsoft accounts" to allow both
# a work Outlook and a personal address. Copy the secret VALUE, not the ID.
# Redirect URIs under Authentication -> Web:
#   http://localhost:3000/oauth/callback/microsoft
#   https://<your-railway-domain>/oauth/callback/microsoft
# ---------------------------------------------------------------------------

MS_CLIENT_ID=
MS_CLIENT_SECRET=

# 'common' supports work and personal accounts. A tenant id restricts to one org.
MS_TENANT_ID=common

# ---------------------------------------------------------------------------
# IMAP needs no server configuration. Host, port and app password are entered
# per mailbox in the connect dialog and encrypted with ENCRYPTION_KEY.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Meta — Facebook Pages, Instagram and Ads, one grant for all three
# developers.facebook.com -> Create app -> Business
# Redirect URI under Facebook Login -> Settings -> Valid OAuth Redirect URIs:
#   https://<your-railway-domain>/oauth/callback/meta
# Business Verification must be complete before ads_read returns data.
#
# One sign-in yields several accounts: one per Page you grant, one per linked
# Instagram business account, and one per ad account. Facebook's dialog lets you
# pick which Pages to include, so granting one of four is a normal outcome.
#
# Messaging permissions are deliberately not requested. pages_messaging and
# instagram_manage_messages are Advanced Access and would fail review without a
# messaging feature to demonstrate. When they land, those threads belong in the
# Inbox as accounts, not in the Social view.
# ---------------------------------------------------------------------------

META_APP_ID=
META_APP_SECRET=

# Invented by you, echoed back during webhook subscription setup.
META_WEBHOOK_VERIFY_TOKEN=

# ---------------------------------------------------------------------------
# X — metered per call, no free tier since Feb 2026. Reads bill at $0.005.
# developer.x.com -> Projects & Apps -> OAuth 2.0, type "Web App"
# Callback: https://<your-railway-domain>/oauth/callback/x
#
# Responses are cached 15 minutes and every call is counted into sync_state under
# the key 'x:calls', with a running dollar estimate, so the spend is visible
# before the invoice is.
# ---------------------------------------------------------------------------

X_CLIENT_ID=
X_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# YouTube reuses GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET. It needs its own
# redirect URI registered on the same OAuth client, because it is a separate
# provider row rather than an extra scope on Google:
#   https://<your-railway-domain>/oauth/callback/youtube
# Enable the YouTube Data API and the YouTube Analytics API on that project.
# ---------------------------------------------------------------------------

# When the social poller runs: fixed wall-clock times in a named zone, not an
# interval. Platform APIs are never called from a request handler; the read
# routes serve the snapshot tables, and the Fetch now button on each platform
# view pulls that family on demand. Defaults: 06:00 and 12:00 America/Chicago.
# Comma-separated HH:MM. SOCIAL_POLL_MINUTES is no longer read.
SOCIAL_SCHEDULE=06:00,12:00
SOCIAL_SCHEDULE_TZ=America/Chicago

# ---------------------------------------------------------------------------
# GoHighLevel — READ from Supabase, SEND to GHL
#
# command-center does not sync GHL. An external pipeline (a backfill script and
# n8n webhooks) owns GHL -> Supabase, and this dashboard reads the result: lead,
# ghl_message, ghl_conversation, ghl_opportunity, ghl_pipeline_stage, appointment
# and the rest, through lib/ghl-data.js. There is no paging, no cursor and no
# reconcile timer here any more.
#
# The one call that still reaches GHL is sending a message, because GHL owns
# delivery. So a token is still needed — scoped to WRITE, not read:
#   conversations/message.write   (required, to send)
#   contacts.write                (optional, the Details tab's inline edits)
#   opportunities.write           (optional, stage and value changes)
#   locations.readonly            (optional, only so a pasted token can be
#                                  verified against its own location at connect)
#
# Inbound changes also arrive on POST /webhooks/ghl, which is UNAUTHENTICATED:
# GHL's Custom Webhook action sends no HMAC, so there is nothing to verify, and
# no shared secret is used either. What contains it is the locationId allow-list
# — a payload naming a location you have not connected writes nothing.
#
# Point a GHL workflow's Custom Webhook action at:
#   https://<your-domain>/webhooks/ghl
# and have it set an `event` field to one of: contact.created, contact.updated,
# opportunity.created, opportunity.updated, opportunity.stage, message.inbound,
# message.outbound, note.created.
#
# The processor writes into Supabase. Two shapes to know about: an inbound
# message webhook carries no ids at all and lands in ghl_message_inbox for
# reconciliation, and opportunity.stage carries no pipeline data — it is only a
# trigger, left in webhook_events for the ingest pipeline to diff.
# ---------------------------------------------------------------------------

# GHL_RECONCILE_MINUTES and GHL_BACKFILL_DAYS are gone. command-center no longer
# runs a sync, so there is nothing for them to pace. Set them where the ingest
# pipeline lives instead.

# One TOKEN/LOCATION pair per sub-account, matched on the suffix. Optional
# GHL_LABEL_<NAME> and GHL_COLOR_<NAME> set the sidebar entry; the label falls
# back to the name GHL reports, then to the suffix title-cased, and the colour
# to the next unused swatch.
#
# Tokens never auto-refresh, so rotation is an edit here: on the next deploy the
# new value is detected, verified and stored, and the account's reauth flag
# clears. A label you have since set in the UI is never overwritten from here.
#
# None of these are required at boot. A pair missing its LOCATION is named in
# the log and skipped rather than failing the deploy.
#
# A sub-account no longer needs a token to be READ. Sub-accounts come from
# ghl_location in Supabase, which is also the allow-list the unauthenticated
# webhook is checked against — a location the ingest pipeline has never ingested
# writes nothing. There is no Connect sheet any more; nothing connects.
#
# A token here does exactly one thing: allow SENDING from that location. A
# location with no token is listed, readable, and marked read-only in the
# sidebar.
GHL_TOKEN_LEAVENWEALTH=
GHL_LOCATION_LEAVENWEALTH=
GHL_TOKEN_LEADLI=
GHL_LOCATION_LEADLI=
GHL_TOKEN_LIQUID_LENDING=
GHL_LOCATION_LIQUID_LENDING=
GHL_TOKEN_FOLIO_EXCEL=
GHL_LOCATION_FOLIO_EXCEL=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Messages fetched per mailbox per folder, before merging.
MAIL_FETCH_LIMIT=25

# IANA zone used to decide whether a message shows a clock, "Yesterday" or a
# date, e.g. America/Chicago. Defaults to the server's zone.
AGENT_TIMEZONE=

# Set to 'disable' if your Postgres rejects TLS. Railway's private hostname is
# detected automatically and needs nothing here.
# PGSSLMODE=
