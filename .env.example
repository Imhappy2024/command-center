# Copy to .env for local runs. Never commit the real thing.
# The server refuses to start if any of the four required variables is missing,
# and tells you which one.

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# open | remember | password. Defaults to remember when unset.
#
#   open      No gate. No /login, no redirect, no cookie check. APP_PASSWORD is
#             not required. The rail shows a "No login · public URL" marker so an
#             unprotected deployment never looks like a gated one. Anyone who
#             reaches the domain can read every connected mailbox.
#   remember  One sign-in per browser. 365-day cookie whose expiry slides forward
#             on every request, so a browser in regular use never lapses.
#   password  14-day cookie, no sliding.
AUTH_MODE=remember

# Required unless AUTH_MODE=open.
APP_PASSWORD=

# Signs session and OAuth state cookies. 32+ characters.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Encrypts refresh tokens and IMAP app passwords at rest. 32+ characters.
# Changing it makes every stored credential undecryptable — you reconnect.
ENCRYPTION_KEY=

# Injected by Railway's Postgres plugin. For local runs point it at your own.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------

# Public origin, no trailing slash. OAuth redirect URIs are built from this, and
# Railway's proxy reports http in req.protocol, so it cannot be inferred from
# request headers. Required — but on Railway it is derived automatically from the
# injected RAILWAY_PUBLIC_DOMAIN, so you only need to set it locally or to
# override a custom domain.
PUBLIC_URL=

# Railway injects its own. Only set this for local runs.
PORT=3000

# ---------------------------------------------------------------------------
# Google — Gmail and Google Calendar, one grant for both
# Cloud console -> Clients -> Create client -> Web application.
# Redirect URIs, both of them, byte for byte:
#   http://localhost:3000/oauth/callback/google
#   https://<your-railway-domain>/oauth/callback/google
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Microsoft — Graph mail and calendar, one grant for both
# Entra ID -> App registrations. Supported account types must be
# "any organizational directory and personal Microsoft accounts" to allow both
# a work Outlook and a personal address. Copy the secret VALUE, not the ID.
# Redirect URIs under Authentication -> Web:
#   http://localhost:3000/oauth/callback/microsoft
#   https://<your-railway-domain>/oauth/callback/microsoft
# ---------------------------------------------------------------------------

MS_CLIENT_ID=
MS_CLIENT_SECRET=

# 'common' supports work and personal accounts. A tenant id restricts to one org.
MS_TENANT_ID=common

# ---------------------------------------------------------------------------
# IMAP needs no server configuration. Host, port and app password are entered
# per mailbox in the connect dialog and encrypted with ENCRYPTION_KEY.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# GoHighLevel — leads, by Private Integration Token
#
# GHL is the source of truth; Postgres holds a read mirror. Inbound changes
# arrive on POST /webhooks/ghl, which is UNAUTHENTICATED: GHL's Custom Webhook
# action sends no HMAC, so there is nothing to verify, and no shared secret is
# used either. What contains it is the locationId allow-list — a payload naming
# a location you have not connected writes nothing.
#
# Point a GHL workflow's Custom Webhook action at:
#   https://<your-domain>/webhooks/ghl
# and have it set an `event` field to one of: contact.created, contact.updated,
# opportunity.created, opportunity.updated, opportunity.stage, message.inbound,
# message.outbound, note.created.
# ---------------------------------------------------------------------------

# Minutes between reconcile passes. Incremental hourly, full pass daily.
# Floors at 5.
GHL_RECONCILE_MINUTES=60

# How far back to pull conversations on a first sync. Older threads are not
# mirrored; a full message history is not worth the request budget.
GHL_BACKFILL_DAYS=90

# One TOKEN/LOCATION pair per sub-account, matched on the suffix. Optional
# GHL_LABEL_<NAME> and GHL_COLOR_<NAME> set the sidebar entry; the label falls
# back to the name GHL reports, then to the suffix title-cased, and the colour
# to the next unused swatch.
#
# Tokens never auto-refresh, so rotation is an edit here: on the next deploy the
# new value is detected, verified and stored, and the account's reauth flag
# clears. A label you have since set in the UI is never overwritten from here.
#
# None of these are required at boot. A pair missing its LOCATION is named in
# the log and skipped rather than failing the deploy.
GHL_TOKEN_LEAVENWEALTH=
GHL_LOCATION_LEAVENWEALTH=
GHL_TOKEN_LEADLI=
GHL_LOCATION_LEADLI=
GHL_TOKEN_LIQUID_LENDING=
GHL_LOCATION_LIQUID_LENDING=
GHL_TOKEN_FOLIO_EXCEL=
GHL_LOCATION_FOLIO_EXCEL=

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------

# Messages fetched per mailbox per folder, before merging.
MAIL_FETCH_LIMIT=25

# IANA zone used to decide whether a message shows a clock, "Yesterday" or a
# date, e.g. America/Chicago. Defaults to the server's zone.
AGENT_TIMEZONE=

# Set to 'disable' if your Postgres rejects TLS. Railway's private hostname is
# detected automatically and needs nothing here.
# PGSSLMODE=
